    { "id": "G-17", "severity": "high", "type": "fact", "question": "Is the manager mobile app part of release 1?", "mustInclude": [["no", "not"], ["release 2"]] },
    { "id": "G-18", "severity": "high", "type": "fact", "question": "How is a mistaken sale corrected?", "mustInclude": [["revers"], ["never edited", "not edited", "never edit"]] },
    { "id": "G-19", "severity": "high", "type": "fact", "question": "Where does the storeId used for cloud access come from?", "mustInclude": [["token"], ["never", "not"]] },
    { "id": "G-20", "severity": "high", "type": "fact", "question": "Where are daily backups written?", "mustInclude": [["usb"], ["folder"]] },
