{
  "description": "Golden questions for grounding an AI agent on Apparel PoS.",
  "passThreshold": 0.95,
  "items": [
    { "id": "G-01", "severity": "critical", "type": "fact", "question": "Does billing at the counter need an internet connection?", "mustInclude": [["no", "not"], ["offline", "locally", "local"]] },
    { "id": "G-02", "severity": "critical", "type": "fact", "question": "Can an app talk to Firestore directly?", "mustInclude": [["no", "never", "only"], ["sync_engine"]], "mustNotInclude": ["yes, if"] },
    { "id": "G-03", "severity": "critical", "type": "fact", "question": "How is money stored?", "mustInclude": [["integer"], ["paise"]], "mustNotInclude": ["as a double"] },
    { "id": "G-04", "severity": "critical", "type": "fact", "question": "Can a cashier see cost prices, and what enforces this?", "mustInclude": [["no", "never", "cannot"], ["encrypt"], ["cost"]] },
