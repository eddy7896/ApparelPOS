    { "id": "G-32", "severity": "high", "type": "trap", "question": "What does the GST invoice layout look like?", "mustInclude": [["unverified", "not built", "does not exist yet", "catalogue", "catalog"]] },
    { "id": "G-33", "severity": "high", "type": "trap", "question": "Which pull request added the sync engine?", "mustInclude": [["does not exist yet", "not built", "no pull request", "planned"]] },
