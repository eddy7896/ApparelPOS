    { "id": "G-38", "severity": "high", "type": "command", "question": "Which command runs the tests of the check scripts?", "mustInclude": [["test:checks", "node --test"]] },
    { "id": "G-39", "severity": "high", "type": "command", "question": "Which command runs the counter app locally?", "mustInclude": [["does not exist yet", "planned", "not installed", "unverified"]] },
    { "id": "G-40", "severity": "medium", "type": "command", "question": "Where are architecture decisions recorded?", "mustInclude": [["documentation/decisions", "adr"]] }
