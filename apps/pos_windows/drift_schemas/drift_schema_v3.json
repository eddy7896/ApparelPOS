      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"users\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL UNIQUE COLLATE NOCASE, \"role\" TEXT NOT NULL CHECK (role IN ('CASHIER', 'MANAGER', 'OWNER')), \"credential_hash\" TEXT NOT NULL, \"active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"active\" IN (0, 1)), \"failures\" INTEGER NOT NULL DEFAULT 0, \"lock_count\" INTEGER NOT NULL DEFAULT 0, \"locked_until\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "counters",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"counters\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"lot_first\" INTEGER NOT NULL CHECK(\"lot_first\" BETWEEN 0 AND 999), \"lot_last\" INTEGER NOT NULL CHECK(\"lot_last\" BETWEEN 0 AND 999), \"current_lot\" INTEGER NOT NULL, \"next_serial\" INTEGER NOT NULL CHECK(\"next_serial\" BETWEEN 0 AND 10000), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (lot_last >= lot_first), CHECK (current_lot >= lot_first AND current_lot <= lot_last));"
        }
      ]
    },
    {
      "name": "products",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"products\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"created_by\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
