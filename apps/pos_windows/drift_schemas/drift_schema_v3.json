      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"batches\" (\"id\" TEXT NOT NULL, \"supplier\" TEXT NOT NULL, \"lot\" INTEGER NOT NULL CHECK(\"lot\" BETWEEN 0 AND 999), \"purchased_at\" INTEGER NOT NULL, \"created_by\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
