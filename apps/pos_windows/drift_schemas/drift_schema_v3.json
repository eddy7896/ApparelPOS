      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"variants\" (\"id\" TEXT NOT NULL, \"product_id\" TEXT NOT NULL REFERENCES products (id), \"size\" TEXT NOT NULL, \"color\" TEXT NOT NULL, \"mrp_paise\" INTEGER NOT NULL CHECK(\"mrp_paise\" >= 0), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"product_id\", \"size\", \"color\"));"
        }
      ]
    },
